   "source": [
    "# Setting the spark session timezone to UTC\n",
    "spark.conf.set(\"spark.sql.session.timeZone\", \"UTC\")\n",
    "\n",
    "# Converting the started_at and ended_at columns to timestamp type\n",
    "trips_silver = (\n",
    "    trips_silver\n",
    "    .withColumn(\"started_ts\", to_timestamp(col(\"started_at\")))\n",
    "    .withColumn(\"ended_ts\", to_timestamp(col(\"ended_at\")))\n",
    ")\n",
    "\n",
    "# Did the conversion work?\n",
    "trips_silver.filter(\n",
    "    col(\"started_ts\").isNull() |\n",
    "    col(\"ended_ts\").isNull()\n",
    ").count()\n",
    "\n",
    "# Let's compare the converted timestamps\n",
    "trips_silver.select(\n",
    "    \"started_at\",\n",
    "    \"started_ts\",\n",
    "    \"ended_at\",\n",
    "    \"ended_ts\"\n",
    ").show(10, truncate=False)"
   ]
