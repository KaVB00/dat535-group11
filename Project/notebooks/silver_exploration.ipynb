   "source": [
    "from pyspark.sql.functions import to_timestamp, regexp_extract, row_number, desc, col\n",
    "from pyspark.sql.window import Window\n",
    "\n",
    "wx2 = (wx\n",
    "       .withColumn(\"ts_utc\", to_timestamp(\"time\", \"yyyy-MM-dd'T'HH:mm\"))\n",
    "       .withColumn(\"run_id\", regexp_extract(\"src\", r\"_([0-9T]+Z-[0-9a-f]+)\\.json\", 1)))\n",
    "\n",
    "win = Window.partitionBy(\"city\", \"time\").orderBy(desc(\"run_id\"))\n",
    "\n",
    "silver_weather = (wx2\n",
    "                  .withColumn(\"rn\", row_number().over(win))\n",
    "                  .filter(col(\"rn\") == 1)\n",
    "                  .drop(\"rn\", \"src\", \"time\"))\n",
    "\n",
    "print(silver_weather.count())\n",
    "silver_weather.show(3)"
   ]
  },
