    "spark.conf.set(\"spark.sql.session.timeZone\", \"UTC\")\n",
    "\n",
    "weather_silver = (\n",
    "    weather\n",
    "    .withColumn(\n",
    "        \"hourly_data\",\n",
    "        explode(arrays_zip(\n",
    "            \"hourly.time\",\n",
    "            \"hourly.temperature_2m\",\n",
    "            \"hourly.precipitation\",\n",
    "            \"hourly.wind_speed_10m\"\n",
    "        ))\n",
    "    )\n",
    "    .select(\n",
    "        col(\"latitude\"),\n",
    "        col(\"longitude\"),\n",
    "        col(\"hourly_data.time\").alias(\"time\"),\n",
    "        col(\"hourly_data.temperature_2m\").alias(\"temperature_2m\"),\n",
    "        col(\"hourly_data.precipitation\").alias(\"precipitation\"),\n",
    "        col(\"hourly_data.wind_speed_10m\").alias(\"wind_speed_10m\")\n",
    "    )\n",
    "    .withColumn(\"time_utc\", to_timestamp(\"time\"))\n",
    "    .withColumn(\n",
    "        \"time_local\",\n",
    "        from_utc_timestamp(\"time_utc\", \"Europe/Oslo\")\n",
    "    )\n",
    "    .drop(\"time\")\n",
    ")\n",
    "\n",
    "weather_silver.show(10, truncate=False)\n",
    "weather_silver.printSchema()"
   ]
