    "silver_weather.groupBy(\"city\").agg(\n",
    "    count(\"*\").alias(\"rows\"),\n",
    "    countDistinct(\"ts_utc\").alias(\"distinct_hours\"),\n",
    "    min(\"ts_utc\").alias(\"first_hour\"),\n",
    "    max(\"ts_utc\").alias(\"last_hour\")\n",
    ").show(truncate=False)"
