   "source": [
    "trips_check = trips_silver.withColumn(\n",
    "    \"duration_diff\",\n",
    "    abs(\n",
    "        (unix_micros(to_timestamp(\"ended_at\"))\n",
    "         - unix_micros(to_timestamp(\"started_at\"))) / 1_000_000\n",
    "        - col(\"duration\").cast(\"double\")\n",
    "    )\n",
    ")\n",
    "\n",
    "trips_check.select(\"duration_diff\").summary().show()"
   ]
  },
