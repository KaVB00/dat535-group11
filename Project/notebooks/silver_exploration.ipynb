    "station_durations = (\n",
    "    trips_silver\n",
    "    .groupBy(\"start_station_id\", \"end_station_id\")\n",
    "    .agg(\n",
    "        count(\"*\").alias(\"num_trips\"),\n",
    "        avg(\"duration\").alias(\"mean_duration\"),\n",
    "        min(\"duration\").alias(\"min_duration\")\n",
    "    )\n",
    ")\n",
    "\n",
    "station_durations.filter(\n",
    "    col(\"num_trips\") >= 10\n",
    ").orderBy(\"min_duration\").show(20, truncate=False)"
   ]
